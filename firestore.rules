rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    //* ---------- Helpers ----------

    // Tem usuário logado
    function isSignedIn() {
      return request.auth != null;
    }

    // Documento pertence a quem está logado
    function isTenantOwner(data) {
      return isSignedIn() && data.tenantId == request.auth.uid;
    }

    function isValidName(value) {
      return value is string && value.trim().size() > 0 && value.size() <= 80;
    }

    // Conexão existe - é do mesmo tenant e não foi excluída
    function isActiveConnectionOfTenant(connectionId) {
      let connectionPath = /databases/$(database)/documents/connections/$(connectionId);
      return exists(connectionPath)
        && get(connectionPath).data.tenantId == request.auth.uid
        && get(connectionPath).data.deletedAt == null;
    }

    // Telefone no padrão E.164
    function isValidPhone(value) {
      return value is string && value.matches('^[+][1-9][0-9]{7,14}$');
    }

    //* ---------- Connections ----------

    match /connections/{connectionId} {
      // Conexão nova com campos exatos, no próprio tenant e datas do servidor
      function isValidNewConnection(data) {
        return data.keys().hasOnly(['tenantId', 'name', 'createdAt', 'updatedAt', 'deletedAt'])
          && data.keys().hasAll(['tenantId', 'name', 'createdAt', 'updatedAt', 'deletedAt'])
          && data.tenantId == request.auth.uid
          && isValidName(data.name)
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && data.deletedAt == null;
      }

      // Edição que muda só o nome
      function isRename() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt'])
          && isValidName(request.resource.data.name);
      }

      // Edição que só marca a conexão como excluída
      function isSoftDelete() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'updatedAt'])
          && request.resource.data.deletedAt == request.time;
      }

      // Lê só as próprias conexões
      allow read: if isTenantOwner(resource.data);

      // Cria conexão só pra si mesmo
      allow create: if isSignedIn() && isValidNewConnection(request.resource.data);

      // Renomeia ou exclui. Conexão já excluída fica travada
      allow update: if isTenantOwner(resource.data)
        && resource.data.deletedAt == null
        && request.resource.data.updatedAt == request.time
        && (isRename() || isSoftDelete());

      // Nunca apaga de verdade
      allow delete: if false;
    }

    //* ---------- Contacts ----------

    match /contacts/{contactId} {
      // Contato novo com campos exatos numa conexão ativa do próprio tenant
      function isValidNewContact(data) {
        return data.keys().hasOnly(['tenantId', 'connectionId', 'name', 'phone', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['tenantId', 'connectionId', 'name', 'phone', 'createdAt', 'updatedAt'])
          && data.tenantId == request.auth.uid
          && data.connectionId is string
          && isActiveConnectionOfTenant(data.connectionId)
          && isValidName(data.name)
          && isValidPhone(data.phone)
          && data.createdAt == request.time
          && data.updatedAt == request.time;
      }

      // Muda só nome e telefone
      function isValidContactUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'updatedAt'])
          && isValidName(request.resource.data.name)
          && isValidPhone(request.resource.data.phone)
          && request.resource.data.updatedAt == request.time;
      }

      // Lê só os próprios contatos
      allow read: if isTenantOwner(resource.data);

      // Cria contato só em conexão ativa que é sua
      allow create: if isSignedIn() && isValidNewContact(request.resource.data);

      // Edita só enquanto a conexão estiver ativa
      allow update: if isTenantOwner(resource.data)
        && isActiveConnectionOfTenant(resource.data.connectionId)
        && isValidContactUpdate();

      // Apaga, mas só enquanto a conexão estiver ativa
      allow delete: if isTenantOwner(resource.data)
        && isActiveConnectionOfTenant(resource.data.connectionId);
    }

    //* ---------- Messages ----------

    match /messages/{messageId} {
    
      function isValidContent(value) {
        return value is string && value.trim().size() > 0 && value.size() <= 1000;
      }

      // 1 a 500 destinatários
      function isValidRecipients(value) {
        return value is list && value.size() > 0 && value.size() <= 500;
      }

      // Enviar agora nasce enviada com a hora do servidor
      function isImmediateSend(data) {
        return data.status == 'sent'
          && data.sentAt == request.time
          && data.scheduledAt == null;
      }

      // Agendar
      function isScheduling(data) {
        return data.status == 'scheduled'
          && data.scheduledAt is timestamp
          && data.scheduledAt > request.time
          && data.sentAt == null;
      }

      // Mensagem nova com campos exatos
      function isValidNewMessage(data) {
        return data.keys().hasOnly(['tenantId', 'connectionId', 'content', 'recipients', 'status', 'scheduledAt', 'sentAt', 'editedAt', 'createdAt', 'updatedAt'])
          && data.keys().hasAll(['tenantId', 'connectionId', 'content', 'recipients', 'status', 'scheduledAt', 'sentAt', 'editedAt', 'createdAt', 'updatedAt'])
          && data.tenantId == request.auth.uid
          && data.connectionId is string
          && isActiveConnectionOfTenant(data.connectionId)
          && isValidContent(data.content)
          && isValidRecipients(data.recipients)
          && data.editedAt == null
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && (isImmediateSend(data) || isScheduling(data));
      }

      // Editar
      function isValidEdit() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'recipients', 'scheduledAt', 'editedAt', 'updatedAt'])
          && isValidContent(request.resource.data.content)
          && isValidRecipients(request.resource.data.recipients)
          && request.resource.data.editedAt == request.time
          && request.resource.data.updatedAt == request.time;
      }

      // Agendada pode trocar a data desde que continue no futuro
      function isValidScheduledEdit() {
        return resource.data.status == 'scheduled'
          && request.resource.data.scheduledAt is timestamp
          && request.resource.data.scheduledAt > request.time;
      }

      // Enviada não muda data
      function isValidSentEdit() {
        return resource.data.status == 'sent'
          && request.resource.data.scheduledAt == resource.data.scheduledAt;
      }

      // Lê só as próprias mensagens
      allow read: if isTenantOwner(resource.data);

      // Cria enviando agora ou agendando
      allow create: if isSignedIn() && isValidNewMessage(request.resource.data);

      // Edita agendada ou enviada - cancelada trava
      allow update: if isTenantOwner(resource.data)
        && isActiveConnectionOfTenant(resource.data.connectionId)
        && isValidEdit()
        && (isValidScheduledEdit() || isValidSentEdit());

      // Apaga
      allow delete: if isTenantOwner(resource.data)
        && isActiveConnectionOfTenant(resource.data.connectionId);
    }
  }
}